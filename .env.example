# -------------------------------------------------------------
# LIFE RPG - Environment Variables
# -------------------------------------------------------------

# Database Connection
# Default local SQLite database (zero-config, full relational persistence):
DATABASE_URL="file:./dev.db"

# For Production (PostgreSQL on Supabase, Neon, or Railway):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret for Session Cookies (Change this in production)
JWT_SECRET="liferpg_hyper_secret_jwt_key_hackathon_2026_gamify_reality_xyz"

# Optional Upstash Redis for Rate Limiting and Leaderboard Caching
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional AI Quest Assistant (Google Gemini API key)
# The app has built-in smart quest generation fallback if this key is not provided!
AI_API_KEY=""

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
